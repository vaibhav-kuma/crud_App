<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.crud.PersonController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <HBox spacing="5">
        <Label text="Name:" prefWidth="60"/>
        <TextField fx:id="nameField" prefWidth="150"/>
        <Label text="Email:" prefWidth="50"/>
        <TextField fx:id="emailField" prefWidth="180"/>
    </HBox>
    <HBox spacing="5">
        <Button text="Add" onAction="#handleAdd"/>
        <Button text="Update" onAction="#handleUpdate"/>
        <Button text="Delete" onAction="#handleDelete"/>
        <Button text="Clear" onAction="#handleClear"/>
    </HBox>
    <TableView fx:id="table" prefHeight="300">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameCol" text="Name" prefWidth="180"/>
            <TableColumn fx:id="emailCol" text="Email" prefWidth="250"/>
        </columns>
    </TableView>
</VBox>
