{
  "/" : {
    "path" : "/",
    "security" : {
      "module" : "NONE"
    },
    "applications" : [ {
      "name" : "JavaFX CRUD App",
      "mainClass" : "com.yourpackage.MainApp",
      "classPathEntries" : [ "/opt/webswing/apps/my-crud-app.jar" ],
      "vmArgs" : "-Xmx512m",
      "dockMode" : "ALL",
      "isolatedFs" : false,
      "autoLogout" : false
    } ]
  }
}
